{
  "name": "infracontrol-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "InfraControl Full-Stack Monorepo Root",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "simulate": "npm --prefix backend run simulate",
    "seed": "npm --prefix backend run seed",
    "test:metrics": "npm --prefix backend run test:metrics",
    "test:rbac": "npm --prefix backend run test:rbac",
    "test:resize": "npm --prefix backend run test:resize",
    "test:db": "npm --prefix backend run test:db",
    "build": "npm --prefix backend install && npm --prefix frontend install --include=dev && npm --prefix frontend run build",
    "start": "node backend/src/server.js"
  },
  "dependencies": {
    "mongodb": "^7.7.0"
  }
}
