# ── Copy to .env on the server and fill in ──────────────────────────────────────

# Public URL people open in the browser (used for CORS and agent install commands)
CLIENT_URL=https://panel.example.com

NODE_ENV=production

# ── MongoDB Credentials ─────────────────────────────────────────────────────────
# Creates the root user on first launch and is used by the app to connect.
# Change BOTH values before the very first `docker compose up`.
MONGO_USERNAME=infracontrol
MONGO_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Application Secrets ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_64_RANDOM_HEX_CHARS
# Encrypts provider API keys (Integrations). Generate with: openssl rand -hex 32 — keep it safe:
# losing it means re-entering every provider API key.
INTEGRATION_SECRET_KEY=CHANGE_ME_TO_64_RANDOM_HEX_CHARS

# ── First Platform Admin ────────────────────────────────────────────────────────
# Used once by: docker compose exec app npm run create-admin
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=CHANGE_ME_min_12_chars
ADMIN_NAME="Platform Admin"

# ── Alert Email (SMTP) ──────────────────────────────────────────────────────────
# Leave SMTP_USER blank to disable email notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="InfraControl Alerts"
ALERT_RECIPIENT_EMAIL=

# ── Cost Reporting ───────────────────────────────────────────────────────────────
COST_CURRENCY=USD
COST_TIMEZONE=UTC

# ── Rate Limiting ────────────────────────────────────────────────────────────────
# Login attempts allowed per IP per 15-minute window
LOGIN_RATE_LIMIT=20

# ── Hardening Switches (leave as-is in production) ──────────────────────────────
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_WEB_TERMINAL=false
METRICS_SIMULATION_FALLBACK=false
# Real provider resizes (Vultr). Keep false until tested on a throwaway server;
# the Simulated provider works regardless.
ENABLE_RESIZE_EXECUTION=false

# ── Demo Only ────────────────────────────────────────────────────────────────────
# Shorten alert durations (0.05 → 10-minute rules fire after 30 s)
# ALERT_DURATION_SCALE=0.05
