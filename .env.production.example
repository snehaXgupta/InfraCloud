# ── Copy to .env on the server and fill in ──────────────────────────────────────

# Public hostname. With a domain, Caddy gets a TLS certificate automatically.
# Use DOMAIN=:80 only for a quick IP-based test (no HTTPS).
DOMAIN=panel.example.com
# Must match the URL people open in the browser
CLIENT_URL=https://panel.example.com

NODE_ENV=production
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_64_RANDOM_HEX_CHARS
# Encrypts provider API keys (Integrations). Generate with: openssl rand -hex 32 — keep it safe:
# losing it means re-entering every provider API key.
INTEGRATION_SECRET_KEY=CHANGE_ME_TO_64_RANDOM_HEX_CHARS

# First admin (used once by: docker compose exec app npm run create-admin)
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=CHANGE_ME_min_12_chars
ADMIN_NAME="Platform Admin"

# Alert email (SMTP). Leave blank to disable email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Server Panel Alerts"
ALERT_RECIPIENT_EMAIL=

# Cost reporting (estimates accrue daily in this timezone)
COST_CURRENCY=USD
COST_TIMEZONE=UTC

# Hardening switches (leave as-is in production)
ALLOW_PUBLIC_REGISTRATION=false
ENABLE_WEB_TERMINAL=false
METRICS_SIMULATION_FALLBACK=false
# Real provider resizes (Vultr). Keep false until tested on a throwaway server; the Simulated
# provider works regardless.
ENABLE_RESIZE_EXECUTION=false

# Demo only: shorten alert durations (0.05 → 10-minute rules fire after 30 s)
# ALERT_DURATION_SCALE=0.05
