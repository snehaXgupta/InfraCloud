PORT=5000
MONGO_URI=mongodb://localhost:27017/server_management_platform
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173

# Free SMTP Email Alert Configuration (Gmail / Resend / Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME="SPACES PANEL Alerts"
ALERT_RECIPIENT_EMAIL=admin@simpel.ai

# Prometheus (private; only the API talks to it). Start locally with ../telemetry/start-prometheus.sh
PROM_URL=http://127.0.0.1:9090
# Show labelled simulated charts for servers with no Prometheus data (defaults to true outside production)
METRICS_SIMULATION_FALLBACK=true

# Cost reporting
COST_CURRENCY=USD
COST_TIMEZONE=UTC
